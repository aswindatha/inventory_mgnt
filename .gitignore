# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Local backend credentials. The anon key is safe to ship in a built app, but a
# filled-in config file is per-developer and should not be committed.
dart_define.json
.env
.env.*

# Build output that does not belong in the repo
*.apk
*.aab
*.ipa

# E2E artifacts (screenshots, recordings) are regenerated by the tool/ scripts
tool/e2e_shots/
tool/e2e_video/
itest_out.txt
itest_run2.txt

# Local Supabase CLI state
supabase/.temp/
supabase/.branches/

# Node tooling for the E2E scripts
tool/node_modules/
tool/package-lock.json

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Windows reserved device name, created by accident by a redirected shell command
nul
